{
  "name": "proxispeak",
  "version": "1.0.0",
  "description": "ProxiSpeak — Geospatial Proximity Audio Ecosystem",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:server && npm run build:client",
    "type-check": "npm run build:server && npm run lint --prefix client",
    "test:spatial": "node server/test-spatial.mjs",
    "test:signaling": "node server/test-signaling.mjs",
    "test": "npm run test:spatial"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
