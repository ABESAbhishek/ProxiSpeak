# Backend (copy to server/.env)
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
AUTHORIZED_ROOM_IDS=global-space
MONGODB_URI=mongodb://127.0.0.1:27017/proxispeak
SESSION_SECRET=replace-with-at-least-32-random-characters
OTP_SECRET=replace-with-a-separate-random-secret
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_WARNING_MINUTES=28
RESEND_API_KEY=replace-with-server-side-resend-key
RESEND_FROM=your-verified-sender@example.com
RESEND_OTP_TEMPLATE_ID=
RESEND_TEST_RECIPIENT=account-owner@example.com

# Frontend (copy VITE_SOCKET_URL into client/.env.local)
VITE_SOCKET_URL=http://localhost:3001
